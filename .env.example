TAVILY_API_KEY=your_tavily_api_key_here

# --- shell_exec tool (opt-in) ---
# Set to "true" to enable the shell_exec tool. Off by default for safety.
# ENABLE_SHELL_EXEC=true
# Audit log path. Will be created with parent dirs if missing.
# SHELL_EXEC_LOG=/var/log/mcp-shell-exec.log
# Comma-separated env keys to pass through to child processes (besides the
# built-in safe set: PATH, LANG, LC_*, HOME, TZ, TERM).
# SHELL_EXEC_PASSTHROUGH_ENVS=
