TAVILY_API_KEY=your_tavily_api_key_here

# --- Staging directory for files uploaded from a remote client (e.g. via scp) ---
# cos_upload's local_path is constrained to this directory (path-traversal guarded).
MCP_UPLOAD_DIR=/home/yunmiao/apps/all-in-one/uploads

# --- Hexo blog tools (5 tools: hexo_list / publish / new / delete / rebuild) ---
# Tools run on the MCP server host and bypass SSH (the MCP server IS the hexo host).
# HEXO_SOURCE_DIR=/home/yunmiao/apps/hexo-source
# HEXO_NVM_PATH=/home/yunmiao/.nvm/nvm.sh
