# MCP All-in-One environment file
# 在宝塔 Node 项目管理器里也可以用「环境变量」字段直接填这些值。

HOST=127.0.0.1
PORT=3030
MCP_ENDPOINT=/mcp

# 用 openssl rand -hex 32 生成
AUTH_TOKEN=replace-me-with-a-strong-random-token

# --- Tool API keys ---

# Web search (Tavily)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Image generate — NewAPI (OpenAI-compatible, default)
# Endpoint base URL (override if you use a different gateway)
NEWAPI_BASE_URL=https://ai.centos.hk/v1
NEWAPI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default NewAPI image model
# NEWAPI_IMAGE_MODEL=gpt-image-2

# Image understand / generate (DashScope / 阿里云百炼, optional fallback)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default DashScope image model
# DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro

# Tencent COS
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COS_BUCKET=your-bucket-1234567890
COS_REGION=ap-beijing
# Optional: public host (CDN domain) for the URL returned by cos_upload / image_generate
# COS_PUBLIC_HOST=cdn.example.com
