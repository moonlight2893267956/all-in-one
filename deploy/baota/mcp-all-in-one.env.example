# MCP All-in-One environment file
# 在宝塔 Node 项目管理器里也可以用「环境变量」字段直接填这些值。

HOST=127.0.0.1
PORT=3030
MCP_ENDPOINT=/mcp

# 用 openssl rand -hex 32 生成
AUTH_TOKEN=replace-me-with-a-strong-random-token

# --- Tool API keys ---

# Web search (Tavily)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Image understand / generate (DashScope / 阿里云百炼)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default image generation model
# DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro

# Image generate (SiliconFlow / 硅基流动, optional)
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default SiliconFlow image model
# SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors

# Tencent COS
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COS_BUCKET=your-bucket-1234567890
COS_REGION=ap-beijing
# Optional: public host (CDN domain) for the URL returned by cos_upload / image_generate
# COS_PUBLIC_HOST=cdn.example.com
