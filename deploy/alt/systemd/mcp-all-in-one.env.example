# MCP All-in-One environment file
# Loaded by systemd (EnvironmentFile=) — do NOT add secrets in the repo.

# HTTP transport settings
HOST=127.0.0.1
PORT=3000
MCP_ENDPOINT=/mcp

# Generate with: openssl rand -hex 32
AUTH_TOKEN=replace-me-with-a-strong-random-token

# Tool-specific API keys
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
